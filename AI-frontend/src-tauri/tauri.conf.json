{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIKU PULSE",
  "version": "0.9.0",
  "identifier": "com.aiscene.mikupulse",
  "build": {
    "beforeDevCommand": "npm run dev:music:tauri",
    "devUrl": "http://127.0.0.1:5173/music.html",
    "beforeBuildCommand": "npm run build:music",
    "frontendDist": "../dist-music"
  },
  "app": {
    "windows": [
      {
        "title": "MIKU PULSE",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3000 https:; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$AUDIO/**", "$DESKTOP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Music",
    "shortDescription": "MIKU PULSE standalone music player",
    "longDescription": "网易云搜索、本地音频、同步双语歌词与 MV 舞台播放器。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
