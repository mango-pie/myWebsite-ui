# 复制为 .env.production 后按服务器环境修改，再执行 npm run build-only

# ---- 方式 A：IP 访问 + Nginx 同域反代（推荐）----
VITE_API_BASE_URL=/api
VITE_PREVIEW_BASE_URL=/api/static
VITE_DEPLOY_BASE_URL=http://121.43.177.236

# ---- 方式 B：域名 + HTTPS（上域名后改用）----
# VITE_API_BASE_URL=https://your-domain.com/api
# VITE_PREVIEW_BASE_URL=/api/static
# VITE_DEPLOY_BASE_URL=https://your-domain.com

# ---- 方式 C：API 直连端口（不推荐生产）----
# VITE_API_BASE_URL=http://121.43.177.236:8123/api
# VITE_PREVIEW_BASE_URL=/api/static
# VITE_DEPLOY_BASE_URL=http://121.43.177.236
